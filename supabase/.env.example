# Supabase — get these from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose to the client

# Plaid — sandbox keys to start, switch to production before real pilot data
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                   # sandbox | development | production

# QuickBooks Online (Intuit Developer)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/webhooks/quickbooks/callback
QUICKBOOKS_ENV=sandbox              # sandbox | production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (invitations). Optional: without these, invitations still work, but you
# share the signup link yourself instead of it being emailed.
# Create a key at https://resend.com, verify your sending domain, then:
RESEND_API_KEY=
EMAIL_FROM="Ledgerline <invites@your-domain.com>"
